<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH default light palette (dsh-web-frontend alias tokens). These are only the
  fallback used before a DSH page has been loaded once; afterwards native pages
  use the theme synchronized from the connected DSH (see DshNativeTheme).
-->
<resources>
    <color name="app_background">#F5F6F7</color>          <!-- bg-module-platform -->
    <color name="app_surface">#FFFFFF</color>             <!-- bg-layer-2 -->
    <color name="app_surface_translucent">#F2FFFFFF</color>
    <color name="app_surface_tinted">#F0F1F3</color>      <!-- interactive-bg-hover over bg-layer-2 -->
    <color name="app_foreground">#0F1115</color>          <!-- label-primary -->
    <color name="app_secondary">#61666B</color>           <!-- label-secondary -->
    <color name="app_border">#1A000000</color>            <!-- border-l2 -->
    <color name="app_accent">#0F1115</color>              <!-- button-primary-fill -->
    <color name="app_on_accent">#FFFFFF</color>           <!-- label-primary-foreground -->
    <color name="app_error">#EC1313</color>               <!-- state-error-primary -->
    <color name="app_success">#22C55E</color>             <!-- state-success-primary -->
</resources>
